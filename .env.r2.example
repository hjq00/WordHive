# Cloudflare R2 上传配置模板
# 用法：复制本文件为 .env.r2，填入自己的值。.env.r2 已在 .gitignore 中，不会被提交。
#
# 获取位置：Cloudflare Dashboard → R2 → 右侧「Manage R2 API Tokens」→ Create API token
# 权限选「Object Read & Write」，范围限定到目标 bucket。
# Secret Access Key 只显示一次，务必立刻保存。

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=your-bucket-name
R2_PREFIX=videos
